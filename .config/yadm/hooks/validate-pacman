#!/bin/bash
staged_pacman=$(git diff --cached --name-only -- '*.config/yadm/pacman.txt')
if [ -z "$staged_pacman" ]; then
  exit 0
fi

pacman_file=$(git diff --cached -- '.config/yadm/pacman.txt' | grep '^+[^+]' | sed 's/^+//' | grep -v '^$')
if [ -z "$pacman_file" ]; then
  exit 0
fi

pkgs=()
while IFS= read -r line; do
  line="${line#+}"
  line="$(echo "$line" | xargs)"
  [ -z "$line" ] && continue
  pkgs+=("$line")
done <<< "$pacman_file"

if [ ${#pkgs[@]} -eq 0 ]; then
  exit 0
fi

repo_pkgs=$(pacman -Slq 2>/dev/null)
if [ -z "$repo_pkgs" ]; then
  echo "validate-pacman: could not read pacman sync databases, skipping validation"
  exit 0
fi

missing=()
for pkg in "${pkgs[@]}"; do
  grep -qx "$pkg" <<< "$repo_pkgs" || missing+=("$pkg")
done

if [ ${#missing[@]} -gt 0 ]; then
  echo "validate-pacman: the following packages were not found in any configured repo:"
  for m in "${missing[@]}"; do
    echo "  - $m"
  done
  exit 1
fi