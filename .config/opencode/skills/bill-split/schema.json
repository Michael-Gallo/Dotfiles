{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bill Split Config",
  "description": "Config piped to build_bill_split.py via stdin. Never persist this with real data.",
  "type": "object",
  "required": ["people", "filename", "receipts"],
  "additionalProperties": false,
  "properties": {
    "people": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "filename": {"type": "string", "description": "Absolute path to the output .xlsx"},
    "date": {"type": "string", "format": "date", "description": "ISO date, e.g. 2026-07-05"},
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "tax", "tip", "subtotal", "items"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 1, "description": "Tab + header name"},
          "tax": {"type": "number", "minimum": 0},
          "tip": {"type": "number", "minimum": 0},
          "discount": {"type": "number", "minimum": 0, "description": "Discount/credit to split proportionally"},
          "subtotal": {"type": "number", "minimum": 0, "description": "Must equal sum of item prices"},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "price"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "price": {"type": "number", "minimum": 0},
                "assigned": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Must be one of `people`; omitted when unknown"
                }
              }
            }
          }
        }
      }
    }
  }
}
